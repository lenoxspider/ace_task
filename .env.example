# ==============================================================================
# Ace775 Environment Configuration
# NOTE: Accounts (phone & password) are now managed directly in the Web Dashboard
# at http://localhost:8000 and securely stored in data/accounts.db.
# ==============================================================================

# Web Dashboard Port (Default: 8000)
PORT=8000

# Website Base URL
ACE_BASE_URL=https://ace775.com

# Telegram Interactive Bot & Daily Notification
# 1. Create a bot using @BotFather on Telegram and paste the token here:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 2. Get your numeric ID by messaging @userinfobot on Telegram and paste here:
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# Optional: Only needed if you wish to run a one-off account via CLI without using the dashboard
# ACE_PHONE=509295199
# ACE_PASSWORD=your_password
