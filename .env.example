# Ace775 Credentials & Settings
ACE_PHONE=0501234567
ACE_PASSWORD=your_password_here

# Automation Mode: 'browser' (Playwright Headless) or 'api' (Direct HTTP Requests)
# 'browser' is full mobile SPA emulation.
# 'api' is ultra-fast & lightweight (ideal for minimal RAM VPS).
ACE_MODE=browser

# Run browser in headless mode (set true for Linux VPS, false to watch it open locally)
ACE_HEADLESS=true

# Task limit (0 for all daily tasks, or e.g. 3 for quick test)
MAX_TASKS=0

# Features to execute
DO_CHECKIN=true
DO_TASKS=true

# Website Base URL
ACE_BASE_URL=https://ace775.com

# Telegram Daily Notification (Optional)
# 1. Create a bot using @BotFather on Telegram and copy the API Token.
# 2. Start your bot in Telegram, then send /start to @userinfobot to get your numeric Chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
